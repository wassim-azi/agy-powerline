# Normalize line endings: LF in the repo and in every checkout, on every OS.
* text=auto eol=lf

# Windows batch files need CRLF (statusline.cmd is generated, this covers any added later).
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.woff2 binary
